# Server-only (Vercel Functions). NEVER prefix secrets with VITE_.
LLM_PROVIDER=gemini          # gemini | anthropic | none (templates only)
LLM_MODEL=                   # optional override
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
RATE_LIMIT_PER_MIN=20
TTS_PROVIDER=gemini          # gemini | sarvam (stub)
TTS_MODEL=                   # Gemini TTS model id, e.g. gemini-3.8-flash-tts (verify in the SDK/docs)

# Client
VITE_USE_MOCK_API=true
