# Server-only (Vercel Functions). NEVER prefix secrets with VITE_.
LLM_PROVIDER=gemini          # gemini | anthropic | none (templates only)
LLM_MODEL=                   # optional override
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
RATE_LIMIT_PER_MIN=20
RATE_LIMIT_BURST=5            # one token bucket shared by /api/recap, /api/ask, /api/learn, /api/speak
TTS_PROVIDER=gemini          # gemini | sarvam (stub)
TTS_MODEL=                   # Gemini TTS model id, e.g. gemini-3.8-flash-tts (verify in the SDK/docs)
SPEAK_SIGNING_SECRET=        # REQUIRED in production: >= 32 random chars (e.g. `openssl rand -base64 48`). Signs the
                             # speakToken that recap/ask/learn return and /api/speak verifies. Without it voice
                             # falls back to the browser voice. Must be the same on every deployment instance.
TRANSCRIBE_DAILY_BUDGET=300     # max /api/transcribe calls per UTC day per instance (paid model time)

# Client
VITE_USE_MOCK_API=false      # 'true' = offline mock (no /api needed); anything else = real /api/recap + /api/ask
